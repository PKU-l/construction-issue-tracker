# 复制为 .env.local 并填入你自己的信息（.env.local 不会被提交）
# 部署到 Netlify 时，在站点环境变量里设置同名变量
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 以下为可选的项目品牌信息（不设置则使用通用名称）
VITE_PROJECT_TITLE=Silo Project
VITE_PROJECT_SHORT=Silo Project
VITE_ORG_LINE=Construction Management
VITE_ORG_BADGE=CM
VITE_PROJECT_FOOTER=Slipform Construction
# 登录页背景图，放在 public/ 下，例如 /hero.png
VITE_HERO_IMAGE=
VITE_EXCEL_SUFFIX=
VITE_EXPORT_PROJECT_NAME=某粮仓工程项目
VITE_EXPORT_ORGANIZATION=
